---
import { getNode, base } from './lib';
const { id } = Astro.props;
const node = getNode(id);
---
<dl class="facts">
	<dt>Node name</dt><dd>{node.display_name}</dd>
	<dt>Node ID</dt><dd><code>{node.id}</code></dd>
	<dt>Find it</dt><dd>Double-click the canvas and search for “{node.display_name.replace(/^BytePlus /, '')}”, or browse <code>{node.category}</code></dd>
	<dt>Keys needed</dt>
	<dd>
		{node.keys.map((key: string, index: number) => (
			<>{index > 0 && ', '}<a href={`${base}/get-started/api-keys/`}>{key}</a></>
		))}
	</dd>
	<dt>Runs when</dt><dd>Its output is used by another node, such as Save Image or Save Video. It is not an output node.</dd>
</dl>
