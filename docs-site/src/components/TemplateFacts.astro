---
import { getTemplate, getNode, nodeUrl, base, shortName } from './lib';
const { file } = Astro.props;
const t = getTemplate(file);
---
<dl class="facts">
	<dt>Template</dt><dd>{t.title}, in the ComfyUI template browser under BytePlus</dd>
	<dt>Workflow file</dt><dd><a href={`${base}/workflows/${t.slug}.json`} download={t.file}>{t.file}</a></dd>
	<dt>BytePlus nodes</dt>
	<dd>
		{t.nodes.map((n: any, index: number) => (
			<>{index > 0 && ', '}<a href={nodeUrl(n.id)}>{shortName(getNode(n.id))}</a>{n.count > 1 && ` ×${n.count}`}</>
		))}
	</dd>
	<dt>Keys needed</dt>
	<dd>
		{t.keys.length === 0 && 'None'}
		{t.keys.map((key: string, index: number) => (
			<>{index > 0 && ', '}<a href={`${base}/get-started/api-keys/`}>{key}</a></>
		))}
	</dd>
	<dt>Also uses</dt><dd>{t.other_nodes.length ? t.other_nodes.join(', ') + ' (built into ComfyUI)' : 'Only BytePlus nodes'}</dd>
</dl>
