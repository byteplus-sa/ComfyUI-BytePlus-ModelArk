      "properties": {},
      "widgets_values": [
        "Set the LAS key in Settings > BytePlus. Two independent examples: external audio replaces speech, while source-audio mode retains the video's audio. Choose one branch to run by disconnecting the other Save Video. Set a writable TOS directory on the branch you run. External audio must match video duration within one second unless override loops/trims video. No translated captions or TTS in these modes."
      ],
      "widgets_values_named": {
        "text": "Set the LAS key in Settings > BytePlus. Two independent examples: external audio replaces speech, while source-audio mode retains the video's audio. Choose one branch to run by disconnecting the other Save Video. Set a writable TOS directory on the branch you run. External audio must match video duration within one second unless override loops/trims video. No translated captions or TTS in these modes."
      },
      "color": "#432",
      "bgcolor": "#653"
    }
